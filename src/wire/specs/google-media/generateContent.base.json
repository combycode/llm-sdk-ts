{
  "id": "google/media.generateContent",
  "provider": "google",
  "api": "generateContent",
  "_note": "Inline-media path: the same :generateContent endpoint the chat spec uses, but driven by responseModalities. Shared by gemini image and gemini tts.",
  "envelope": {
    "method": "POST",
    "url": { "$join": [{ "$config": "baseURL" }, "/v1beta/models/", { "$": "model" }, ":generateContent?key=", { "$config": "apiKey" }] },
    "headers": [{ "name": "content-type", "value": "application/json" }]
  },
  "blocks": [
    { "name": "contents", "to": "contents", "template": [{ "parts": [{ "text": { "$": "prompt" } }] }] },
    { "name": "generationConfig.root", "to": "generationConfig", "merge": true, "template": {} }
  ]
}
