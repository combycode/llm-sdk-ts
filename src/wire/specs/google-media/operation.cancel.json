{
  "id": "google/media.operation.cancel",
  "provider": "google",
  "api": "media",
  "envelope": {
    "method": "POST",
    "url": {
      "$join": [
        {
          "$config": "baseURL"
        },
        "/v1beta/",
        {
          "$": "operationId"
        },
        ":cancel?key=",
        {
          "$config": "apiKey"
        }
      ]
    },
    "headers": [
      {
        "name": "content-type",
        "value": "application/json"
      }
    ]
  },
  "_note": "Cancel a long-running operation. The key rides on the query string, so the only header is the POST's content-type - unlike the status poll, which sends the x-goog-api-key header as well."
}
