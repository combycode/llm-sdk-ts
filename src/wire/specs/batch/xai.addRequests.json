{
  "id": "xai/batch.addRequests",
  "extends": "xai/batch.base",
  "_note": "Step 2 of submit. Step 1 creates the batch and is NOT modelled: its body embeds Date.now(), so the request is not reproducible. See report 039 A3.",
  "envelope": {
    "method": "POST",
    "url": { "$join": [{ "$config": "baseURL" }, "/v1/batches/", { "$": "batchId" }, "/requests"] },
    "headers": [{ "name": "content-type", "value": "application/json" }]
  },
  "blocks": [
    {
      "name": "batch_requests",
      "to": "batch_requests",
      "template": {
        "$map": "requests",
        "$case": [
          {
            "value": {
              "batch_request_id": { "$": "@customId" },
              "batch_request": { "endpoint": "responses", "body": { "$": "@body" } }
            }
          }
        ]
      }
    }
  ]
}
